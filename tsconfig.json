{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022","DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "jest.config.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}